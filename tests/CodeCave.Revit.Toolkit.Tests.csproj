<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 exercises the .NET Framework (Revit 2019-2024) code path,
         net8.0-windows exercises the Revit 2025+ code path -->
    <TargetFrameworks>net8.0-windows</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT'">net48;net8.0-windows</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- Directory.Build.props disables this before TargetFrameworks is defined; re-enable so each TFM gets its own output folder -->
    <AppendTargetFrameworkToOutputPath Condition="'$(TargetFrameworks)' != ''">true</AppendTargetFrameworkToOutputPath>
    <BuildInParallel Condition="'$(TargetFrameworks)' != ''">false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="[17.*, 18.0)" />
    <PackageReference Include="OpenCover" Version="4.7.*" />
    <PackageReference Include="xunit" Version="2.4.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.*" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\bin\Release\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\bin\Debug\</OutputPath>
    <DebugType>full</DebugType>
    <NoWarn>1701;1702;1705</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Resources\**\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\TypeCatalogFile\Invalid\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\CodeCave.Revit.Toolkit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Thumbnails\**\*.*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CleanTestFiles" AfterTargets="Clean">
    <ItemGroup>
      <ValidShared Include="$(OutputPath)Resources\SharedParameterFiles\Valid\*.txt" />
      <InvalidShared Include="$(OutputPath)Resources\SharedParameterFiles\Invalid\*.txt" />
    </ItemGroup>
    <Message Text="Deleting Shared parameter files from $(OutputPath)Resources\SharedParameterFiles" Importance="high" />
    <Delete Files="@(ValidShared)" />
    <Delete Files="@(InvalidShared)" />
  </Target>

</Project>
